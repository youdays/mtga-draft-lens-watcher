# macOSでは ~/Library/Logs/Wizards of the Coast/MTGA/Player.log を使用します。
# WindowsではOSのホーム配下の AppData/LocalLow/Wizards Of The Coast/MTGA/Player.log を使用します。
# 既定パスと異なる場合やその他のOSではPlayer.logの絶対パスを指定してください。
# PLAYER_LOG_PATH="C:/Users/ユーザー名/AppData/LocalLow/Wizards Of The Coast/MTGA/Player.log"

# 指定するとGitHub Pagesの既定の許可元を置き換えます（カンマ区切り）。
# HTTPのlocalhostと127.0.0.1は設定によらず任意ポートで許可します。
# ALLOWED_ORIGINS=https://youdays.github.io
